# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas Cluster 0 Connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vishakha_astra?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/vishakha_astra?retryWrites=true&w=majority"

# JWT Secret for User Sessions and Authentication:
JWT_SECRET="vishakha_astra_super_secret_jwt_key_2026"

# Port (Default 3000 for AI Studio & Render)
PORT=3000

# Client URL (for CORS in production when frontend is deployed separately)
CLIENT_URL=""
